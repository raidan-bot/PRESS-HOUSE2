# =========================================================================
# بيت الصحافة (PressHouse) - ملف متغيرات البيئة الشامل والموحد
# PressHouse Enterprise Platform - Unified Environment Configuration
# =========================================================================

# -------------------------------------------------------------------------
# 1. إعدادات خادم التطبيق والنطاق (Server Core & Domain Settings)
# -------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DOMAIN=ph-ye.org
APP_URL=https://ph-ye.org
APP_PATH=/Data/presshouse

# إعدادات الواجهة الأمامية (Vite Frontend Configuration)
VITE_DOMAIN=ph-ye.org
VITE_API_URL=https://ph-ye.org
VITE_ADMIN_PATH=/admin
VITE_ROOT_PATH=/root

# -------------------------------------------------------------------------
# 2. حسابات النظام والمسؤولين (System Admin Accounts & Identity Seeds)
# -------------------------------------------------------------------------
ROOT_ADMIN_EMAIL=raidan@ph-ye.org
ROOT_ADMIN_PASSWORD=
DEFAULT_ADMIN_PASSWORD=
SYSTEM_ADMIN_EMAIL=admin@ph-ye.org
SYSTEM_NO_REPLY_EMAIL=no-reply@ph-ye.org
SYSTEM_REGISTER_EMAIL=register@ph-ye.org
SYSTEM_ASSISTANT_EMAIL=assistant@ph-ye.org
ADMIN_NOTIFICATION_EMAIL=raidan@ph-ye.org

# -------------------------------------------------------------------------
# 3. الأمان والتشفير والجلسات (Security, Encryption Keys & JWT Sessions)
# -------------------------------------------------------------------------
# يوصى بتوليد مفاتيح عشوائية آمنة بحجم 64 بابت (Base64)
JWT_SECRET=
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=
SESSION_SECRET=
API_RATE_LIMIT_KEY=
WEBHOOK_SECRET=
CRON_SECRET=

# -------------------------------------------------------------------------
# 4. قاعدة البيانات (Database Configuration: SQLite / MySQL / PostgreSQL)
# -------------------------------------------------------------------------
DB_TYPE=sqlite
SQLITE_DB_PATH=database.sqlite

# خيارات التوصيل بقواعد البيانات الخارجية (PostgreSQL / MySQL)
POSTGRES_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=presshouse
MYSQL_PASSWORD=
MYSQL_DATABASE=presshouse_db

# -------------------------------------------------------------------------
# 5. محركات الذكاء الاصطناعي (AI Engines & Gemini Integration)
# -------------------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL_PRIMARY=gemini-2.5-flash
FIRECRAWL_API_KEY=

# -------------------------------------------------------------------------
# 6. إعدادات خادم البريد الإلكتروني (SMTP Mail Services)
# -------------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=web@ph-ye.org
SMTP_PASSWORD=
SMTP_FROM="بيت الصحافة <web@ph-ye.org>"

# -------------------------------------------------------------------------
# 7. بوت تليجرام للتنبيهات الفورية (Telegram Observatory Bot)
# -------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true

# -------------------------------------------------------------------------
# 8. تسجيل الدخول عبر الخدمات الخارجية (OAuth 2.0 Credentials)
# -------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# -------------------------------------------------------------------------
# 9. التخزين الميداني والمرفقات (File Uploads & Media Storage)
# -------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=/Data/presshouse/uploads
MAX_FILE_SIZE_MB=50

# -------------------------------------------------------------------------
# 10. النسخ الاحتياطي والسجلات (Backups & Retention Settings)
# -------------------------------------------------------------------------
BACKUP_DIR=/Data/presshouse/backups
BACKUP_RETENTION_DAYS=30
